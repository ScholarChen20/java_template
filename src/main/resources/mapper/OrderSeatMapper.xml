<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.yoyo_data.infrastructure.repository.OrderSeatMapper">
    <select id="selectIdsByOrderId" resultType="java.lang.Long">
        SELECT
            seat_id
        FROM
            tb_order_seat
        WHERE
            order_id = #{orderId}
    </select>
</mapper>