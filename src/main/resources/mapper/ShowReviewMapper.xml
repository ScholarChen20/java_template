<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.yoyo_data.infrastructure.repository.ShowReviewMapper">
    <select id="selectTagsByShowEventId" resultType="java.lang.String">
        SELECT
            tags
        FROM
            tb_show_review
        WHERE
            show_event_id = #{showEventId}
          AND is_deleted = 0
          AND tags IS NOT NULL
    </select>
    <select id="selectRatingDistribution" resultType="com.example.yoyo_data.common.vo.ShowRatingVO">
        SELECT
            rating, COUNT(*) as cnt
        FROM
            tb_show_review
        WHERE
            show_event_id = #{showEventId}
          AND is_deleted = 0
        GROUP BY
            rating
    </select>
</mapper>